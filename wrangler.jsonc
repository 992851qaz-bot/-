{
  // Worker 名稱 "www" + 帳號子網域 "992851qaz" = https://www.992851qaz.workers.dev
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // 只有 /download 開頭的網址會先經過 Worker，其他都直接回靜態檔案（不算 Worker 請求次數）
    "run_worker_first": ["/download", "/download/*", "/api/*"]
  }
}
