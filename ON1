        function matchOrRegisterCharacter(rawCharName) {
            if (!rawCharName) return null;
            const clean = rawCharName.replace(/[^\u4e00-\u9fa5A-Za-z]/g, "").trim();
            if (!clean || clean.length < 1) return null;

            const blacklist = ["屬性詳情", "屬性", "詳情", "聲骸技能", "聲骸", "合鳴", "培養", "卸下", "推薦", "未裝備", "簡述", "暴擊", "傷害", "攻擊", "生命", "防禦", "效率", "當前", "等級", "上限", "戰鬥風格"];
            if (blacklist.some(w => clean === w || clean.includes("傷害") || clean.includes("加成"))) return null;

            const keys = Object.keys(CHAR_PRESETS);
            for (const k of keys) {
                const zhPart = k.split("(")[0].replace(/[^\u4e00-\u9fa5]/g, "").trim();
                if (zhPart && (zhPart === clean || k.includes(clean) || clean.includes(zhPart))) {
                    return k;
                }
            }

            if (clean.length >= 2) {
                let bestKey = null;
                let bestScore = 0;
                for (const k of keys) {
                    const zhPart = k.split("(")[0].replace(/[^\u4e00-\u9fa5]/g, "").trim();
                    if (!zhPart || Math.abs(zhPart.length - clean.length) > 1) continue;
                    let shared = 0;
                    for (const ch of clean) {
                        if (zhPart.includes(ch)) shared++;
                    }
                    if (shared >= Math.max(2, zhPart.length - 1) && shared > bestScore) {
                        bestScore = shared;
                        bestKey = k;
                    }
                }
                if (bestKey) return bestKey;
            }

            if (clean.length >= 2 && clean.length <= 5) {
                if (!CHAR_PRESETS[clean]) {
                    CHAR_PRESETS[clean] = {
                        build: "自動辨識角色",
                        weights: { ...DEFAULT_DPS_WEIGHTS }
                    };
                    rebuildRoleSelectOptions(clean);
                }
                return clean;
            }
            return null;
        }

