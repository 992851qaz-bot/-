                };
            }

            const cv = cr * 2 + cd;
            let mainScaleScore = 0;
            if ((w["HP"] || 0) >= 0.8 && (w["HP"] || 0) > (w["Attack"] || 0)) {
                mainScaleScore = Math.min(100, (hp / 38000) * 100);
            } else if ((w["Defence"] || 0) >= 0.8 && (w["Defence"] || 0) > (w["Attack"] || 0)) {
                mainScaleScore = Math.min(100, (def / 3200) * 100);
            } else {
                mainScaleScore = Math.min(100, (atk / 2250) * 100);
            }

            const critScore = Math.min(100, (cv / 390) * 100);
            const erTarget = (w["ER"] || 0) >= 0.7 ? 135 : 120;
            const erScore = Math.min(100, (Math.max(100, er) / erTarget) * 100);

            const isCritRole = (w["Crit_Rate"] || 0) >= 0.5 || (w["Crit_Damage"] || 0) >= 0.5;
            const totalPct = isCritRole
                ? Math.min(100, critScore * 0.62 + mainScaleScore * 0.28 + erScore * 0.10)
                : Math.min(100, mainScaleScore * 0.60 + erScore * 0.40);

            let badgeClass = "badge-c";
            let tierTitle = "♻ C 尚待培養";
            let advice = "";
            let isWarn = false;

            if (totalPct >= 88) {
