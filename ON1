            } else if (totalPct >= 62) {
                badgeClass = "badge-a";
                tierTitle = "✨ A 實戰可用";
                advice = `✨ 【小畢業及格面板】雙暴總分 ${cv.toFixed(1)}，建議持續優化聲骸雙暴與有效詞條。`;
            } else if (totalPct >= 45) {
