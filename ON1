            };

            const hp = parseNum(stats["生命"]);
            const atk = parseNum(stats["攻擊"]);
            const def = parseNum(stats["防禦"]);
            const er = parseNum(stats["共鳴效率"]);
            const cr = parseNum(stats["暴擊"]);
            const cd = parseNum(stats["暴擊傷害"]);

            if (hp === 0 && atk === 0 && cr === 0 && cd === 0) {
                return {
                    hasData: false,
                    cv: 0,
                    pct: 0,
                    tierTitle: "-- 等待分析",
                    badgeClass: "badge-c",
