        function evaluateCharacterPanelStats(charName, stats) {
            const cfg = CHAR_PRESETS[charName] || { weights: DEFAULT_DPS_WEIGHTS };
            const w = cfg.weights || DEFAULT_DPS_WEIGHTS;

            const parseNum = v => {
                if (!v || v === "--") return 0;
                const m = String(v).match(/(\d+(?:\.\d+)?)/);
