        function preprocessCanvasForOCR(ctx, width, height, mode = "strong") {
            const imgData = ctx.getImageData(0, 0, width, height);
            const data = imgData.data;

            const offset = mode === "soft" ? 46 : 68;
            const gain = mode === "soft" ? 1.48 : 1.82;

            for (let i = 0; i < data.length; i += 4) {
                const lum = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
                const inverted = 255 - lum;
                const val = Math.max(0, Math.min(255, (inverted - offset) * gain));
                data[i] = val;
                data[i + 1] = val;
                data[i + 2] = val;
            }
            ctx.putImageData(imgData, 0, 0);
        }

        function normalizeOcrLine(input) {
            if (!input) return "";
            let s = input.replace(/[０-９]/g, ch =>
                String.fromCharCode(ch.charCodeAt(0) - 0xFEE0)
            );
            s = s
                .replace(/％/g, "%")
                .replace(/[，,、·•・]/g, ".")
                .replace(/[：﹕]/g, ":")
                .replace(/\s+/g, "");

            s = s
                .replace(/(?<=\d)[Oo](?=[\d.%]|$)/g, "0")
                .replace(/(?<=^|[^A-Za-z])[Oo](?=\d)/g, "0")
                .replace(/(?<=\d)[Il|](?=[\d.%]|$)/g, "1")
                .replace(/(?<=^|[^A-Za-z])[Il|](?=\d)/g, "1")
                .replace(/(\d)[。.](\d)/g, "$1.$2");

            return s;
        }

        function countMatchingSubstats(a, b) {
            if (!a || !b) return 0;
            let count = 0;
            for (const current of a.substats || []) {
                const hit = (b.substats || []).find(prev =>
                    prev.key === current.key && Math.abs(prev.val - current.val) <= 0.25
                );
                if (hit) count++;
            }
            return count;
        }

        function mergeParsedResults(base, extra) {
            if (!extra) return base;

            const merged = {
                name: base.name,
                cost: base.cost,
                mainStat: base.mainStat,
                equippedChar: base.equippedChar || extra.equippedChar || "",
                substats: [...(base.substats || [])]
            };

            if (
                merged.mainStat === "未偵測到主屬性" &&
                extra.mainStat &&
                extra.mainStat !== "未偵測到主屬性"
            ) {
                merged.mainStat = extra.mainStat;
            }

            if (
                (!merged.name || merged.name.startsWith("已辨識聲骸")) &&
                extra.name &&
                !extra.name.startsWith("已辨識聲骸")
            ) {
                merged.name = extra.name;
            }

            if (extra.cost) merged.cost = extra.cost;

            for (const item of extra.substats || []) {
                if (merged.substats.length >= 5) break;
                const exists = merged.substats.some(s =>
                    s.key === item.key && Math.abs(s.val - item.val) <= 0.25
                );
                const sameKey = merged.substats.some(s => s.key === item.key);
                if (!exists && !sameKey) merged.substats.push(item);
            }

            return merged;
        }

        function stabilizeRecognition(current) {
            if (!lastRecognizedEcho || !current) return current;

            const sameMain =
                current.mainStat !== "未偵測到主屬性" &&
                current.mainStat === lastRecognizedEcho.mainStat;

            const overlap = countMatchingSubstats(current, lastRecognizedEcho);

            if (
                sameMain &&
                current.substats.length >= 3 &&
                lastRecognizedEcho.substats.length > current.substats.length &&
                overlap >= Math.min(3, current.substats.length)
            ) {
                return mergeParsedResults(current, lastRecognizedEcho);
            }

            return current;
        }

        async function runBottomSubstatFallback(fullCanvas, cropX, cropY, cropW, cropH) {
            const fallbackCanvas = document.createElement("canvas");
            const fctx = fallbackCanvas.getContext("2d", { willReadFrequently: true });

            const bandY = Math.floor(cropY + cropH * 0.34);
            const bandH = Math.floor(cropH * 0.72);
            const scale = 3.5;

            fallbackCanvas.width = Math.floor(cropW * scale);
            fallbackCanvas.height = Math.floor(bandH * scale);

            fctx.imageSmoothingEnabled = true;
            fctx.imageSmoothingQuality = "high";
            fctx.drawImage(
                fullCanvas,
                cropX, bandY, cropW, bandH,
                0, 0, fallbackCanvas.width, fallbackCanvas.height
            );

            preprocessCanvasForOCR(
                fctx,
                fallbackCanvas.width,
                fallbackCanvas.height,
                "soft"
            );

            const res = await ocrWorker.recognize(fallbackCanvas);
            return {
                text: res.data.text || "",
                parsed: parseEchoTextFromOCR(res.data.text || "")
            };
        }

        async function detectTopLeftSceneMode(fullCanvas, vw, vh) {
            const headerCanvas = document.getElementById("header-canvas");
            const hctx = headerCanvas.getContext("2d", { willReadFrequently: true });

            const hx = Math.floor(vw * 0.042);
            const hy = Math.floor(vh * 0.036);
            const hw = Math.floor(vw * 0.095);
            const hh = Math.floor(vh * 0.055);

            const scale = 2.6;
            headerCanvas.width = Math.floor(hw * scale);
            headerCanvas.height = Math.floor(hh * scale);

            hctx.drawImage(fullCanvas, hx, hy, hw, hh, 0, 0, headerCanvas.width, headerCanvas.height);
            preprocessCanvasForOCR(hctx, headerCanvas.width, headerCanvas.height, "soft");

            const res = await ocrWorker.recognize(headerCanvas);
            const txt = normalizeOcrLine(res.data.text || "");
            const isPanel = /(屬性|詳情|属性|详情|屬|詳)/.test(txt) && !/COST/i.test(txt);
            return { isPanel, headerText: txt };
        }

        async function captureAndAnalyzeFrame() {
            if (!videoEl.videoWidth || !videoEl.videoHeight || isBusyOCR) return;
            if (!ocrReady || !ocrWorker) return;

            isBusyOCR = true;
            const t0 = performance.now();
            scanCount++;
            document.getElementById("meta-count").textContent = `${scanCount} 次`;

            try {
                const fullCanvas = document.getElementById("full-canvas");
                const cropCanvas = document.getElementById("crop-canvas");
                const fctx = fullCanvas.getContext("2d", { willReadFrequently: true });
                const cctx = cropCanvas.getContext("2d", { willReadFrequently: true });

                const vw = videoEl.videoWidth;
                const vh = videoEl.videoHeight;
                fullCanvas.width = vw;
                fullCanvas.height = vh;
                fctx.drawImage(videoEl, 0, 0, vw, vh);

                const sceneCheck = await detectTopLeftSceneMode(fullCanvas, vw, vh);

                if (sceneCheck.isPanel) {
                    if (metaSceneEl) metaSceneEl.textContent = "屬性詳情 (角色面板)";
                    switchHudView("panel", g_hudCurrentMode !== "panel");

                    const scale = 3.0;
                    const headerX = Math.floor(vw * 0.098);
                    const headerY = Math.floor(vh * 0.135);
                    const headerW = Math.floor(vw * 0.185);
                    const headerH = Math.floor(vh * 0.145);

                    const statsY = Math.floor(vh * 0.312);
                    const statsH = Math.floor(vh * 0.252);
                    const labelX = Math.floor(vw * 0.128);
                    const labelW = Math.floor(vw * 0.082);
                    const valX = Math.floor(vw * 0.222);
                    const valW = Math.floor(vw * 0.078);

                    const outW = Math.floor(Math.max(headerW, labelW + valW + 12) * scale);
                    const topH = Math.floor(headerH * scale);
                    const botH = Math.floor(statsH * scale);
                    cropCanvas.width = outW;
                    cropCanvas.height = topH + botH + 16;

                    cctx.fillStyle = "#000000";
                    cctx.fillRect(0, 0, cropCanvas.width, cropCanvas.height);
                    cctx.imageSmoothingEnabled = true;
                    cctx.imageSmoothingQuality = "high";

                    cctx.drawImage(
                        fullCanvas,
                        headerX, headerY, headerW, headerH,
                        0, 0, Math.floor(headerW * scale), topH
                    );

                    const lblDestW = Math.floor(labelW * scale);
                    const valDestW = Math.floor(valW * scale);
                    cctx.drawImage(
                        fullCanvas,
                        labelX, statsY, labelW, statsH,
                        0, topH + 12, lblDestW, botH
                    );
                    cctx.drawImage(
                        fullCanvas,
                        valX, statsY, valW, statsH,
                        lblDestW + 10, topH + 12, valDestW, botH
                    );

                    preprocessCanvasForOCR(cctx, cropCanvas.width, cropCanvas.height, "soft");

                    const panelOcr = await ocrWorker.recognize(cropCanvas);
                    const panelText = panelOcr.data.text || "";
                    const parsedPanel = parseCharacterPanelFromOCR(panelText);

                    if (parsedPanel.charName) {
                        tryAutoSwitchCharacter(parsedPanel.charName, "角色屬性面板");
                    }
                    if (parsedPanel.element) g_currentPanelData.element = parsedPanel.element;
                    if (parsedPanel.level) g_currentPanelData.level = parsedPanel.level;

                    const statKeys = Object.keys(parsedPanel.stats);
                    if (statKeys.length >= 2) {
                        for (const [k, v] of Object.entries(parsedPanel.stats)) {
                            g_currentPanelData.stats[k] = v;
                        }
                        refreshCharacterPanelDisplay();
                        const latency = (performance.now() - t0).toFixed(0);
                        document.getElementById("meta-latency").textContent = `${latency} ms`;
                        addLog(`📊 [面板分析成功] 生命:${g_currentPanelData.stats["生命"]} | 攻擊:${g_currentPanelData.stats["攻擊"]} | 雙暴:${g_currentPanelData.stats["暴擊"]}/${g_currentPanelData.stats["暴擊傷害"]} [${latency}ms]`, "log-success");
                    }
                    return;
                }

                if (metaSceneEl) metaSceneEl.textContent = "聲骸裝配頁";
                switchHudView("echo", g_hudCurrentMode !== "echo");

                const cropX = Math.floor(vw * 0.70);
                const cropY = Math.floor(vh * 0.11);
                const cropW = Math.floor(vw * 0.28);
                const cropH = Math.floor(vh * 0.46);

                const eqX = Math.floor(vw * 0.802);
                const eqY = Math.floor(vh * 0.852);
                const eqW = Math.floor(vw * 0.105);
                const eqH = Math.floor(vh * 0.042);

                const scale = 3.0;
                const mainDestW = Math.floor(cropW * scale);
                const mainDestH = Math.floor(cropH * scale);
                const eqDestW = Math.floor(eqW * scale * 1.15);
                const eqDestH = Math.floor(eqH * scale * 1.15);

                cropCanvas.width = mainDestW;
                cropCanvas.height = mainDestH + eqDestH + 14;

                cctx.fillStyle = "#080d1a";
                cctx.fillRect(0, 0, cropCanvas.width, cropCanvas.height);
                cctx.imageSmoothingEnabled = true;
                cctx.imageSmoothingQuality = "high";

                cctx.drawImage(
                    fullCanvas,
                    cropX, cropY, cropW, cropH,
                    0, 0, mainDestW, mainDestH
                );

                cctx.drawImage(
                    fullCanvas,
                    eqX, eqY, eqW, eqH,
                    10, mainDestH + 10, eqDestW, eqDestH
                );

                const rawImgData = cctx.getImageData(0, 0, cropCanvas.width, cropCanvas.height);
                const currentHash = computeFastSampleHash(rawImgData.data);

                const nearSameFrame =
                    lastAcceptedFrameHash !== null &&
                    Math.abs(currentHash - lastAcceptedFrameHash) < 350;

                const forceRescan = scanCount % 6 === 0;

                if (nearSameFrame && lastOcrWasComplete && !forceRescan) {
                    const tDiff = (performance.now() - t0).toFixed(0);
                    document.getElementById("meta-latency").textContent = `${tDiff} ms`;
                    return;
                }

                preprocessCanvasForOCR(cctx, cropCanvas.width, mainDestH, "strong");

                const eqImgData = cctx.getImageData(0, mainDestH, cropCanvas.width, eqDestH + 14);
                const eqData = eqImgData.data;
                for (let i = 0; i < eqData.length; i += 4) {
                    const lum = 0.299 * eqData[i] + 0.587 * eqData[i + 1] + 0.114 * eqData[i + 2];
                    const inv = 255 - lum;
                    const v = Math.max(0, Math.min(255, (inv - 42) * 1.55));
                    eqData[i] = v;
                    eqData[i + 1] = v;
                    eqData[i + 2] = v;
                }
                cctx.putImageData(eqImgData, 0, mainDestH);

                const ocrRes = await ocrWorker.recognize(cropCanvas);
                const text = ocrRes.data.text || "";

                let parsedResult = parseEchoTextFromOCR(text);

                if (parsedResult.equippedChar) {
                    tryAutoSwitchCharacter(parsedResult.equippedChar, "「裝配中」標籤");
                }

                if (
                    parsedResult.substats.length >= 3 &&
                    parsedResult.substats.length < 5
                ) {
                    const fallback = await runBottomSubstatFallback(
                        fullCanvas, cropX, cropY, cropW, cropH
                    );
                    const before = parsedResult.substats.length;
                    parsedResult = mergeParsedResults(
                        parsedResult,
                        fallback.parsed
                    );

                    if (parsedResult.substats.length > before) {
                        addLog(
                            `🧩 [第五詞條補抓] ${before} → ${parsedResult.substats.length} 條`,
                            "log-info"
                        );
                    }
                }

                parsedResult = stabilizeRecognition(parsedResult);

                const latency = (performance.now() - t0).toFixed(0);
                document.getElementById("meta-latency").textContent = `${latency} ms`;

                const hasAnyResult =
                    parsedResult.substats.length > 0 ||
                    parsedResult.mainStat !== "未偵測到主屬性";

                if (hasAnyResult) {
                    lastRecognizedEcho = parsedResult;
                    lastAcceptedFrameHash = currentHash;
                    lastOcrWasComplete = parsedResult.substats.length >= 5;
                    renderEvaluatedHUD(parsedResult, latency);
                } else {
                    lastOcrWasComplete = false;
                    addLog(
                        `⚠️ [未偵測到完整詞條] 原始讀取: ${text.replace(/\s+/g, " ").slice(0, 70)}...`,
                        "log-warn"
                    );
                }
            } catch (e) {
                lastOcrWasComplete = false;
                addLog(`❌ [辨識錯誤] ${e.message}`, "log-warn");
            } finally {
                isBusyOCR = false;
            }
        }

        function computeFastSampleHash(pixels) {
            let hash = 0;
            const pixelCount = Math.floor(pixels.length / 4);
            const stride = Math.max(1, Math.floor(pixelCount / 900));

            for (let p = 0; p < pixelCount; p += stride) {
                const i = p * 4;
                hash = (
                    hash +
                    pixels[i] * 31 +
                    pixels[i + 1] * 17 +
                    pixels[i + 2] * 13
                ) | 0;
            }
            return hash;
        }

        function parseCharacterPanelFromOCR(rawText) {
            const out = {
                charName: "",
                element: "",
                level: "",
                stats: {}
            };

            const lines = rawText.split("\n").map(l => normalizeOcrLine(l)).filter(Boolean);
            const cleanText = lines.join(" ");

            const elemMatch = cleanText.match(/(導電|熱熔|冷凝|氣動|衍射|湮滅)/);
            if (elemMatch) out.element = elemMatch[1];

            const lvlMatch = cleanText.match(/L[vV]\.?\s*(\d{1,2}(?:\/\d{1,2})?)/);
            if (lvlMatch) out.level = `Lv ${lvlMatch[1]}`;

            for (let i = 0; i < Math.min(5, lines.length); i++) {
                const line = lines[i];
                if (/L[vV]\d|屬性|詳情|生命|攻擊|防禦|效率|暴擊/.test(line)) continue;
                const cleanLine = line.replace(/(導電|熱熔|冷凝|氣動|衍射|湮滅)/g, "");
                const zhName = cleanLine.match(/[\u4e00-\u9fa5]{2,5}/);
                if (zhName) {
                    out.charName = zhName[0];
                    break;
                }
            }

            const hpMatch = cleanText.match(/(?:生命)[^0-9]{0,8}(\d{3,6})/);
            if (hpMatch) out.stats["生命"] = hpMatch[1];

            const atkMatch = cleanText.match(/(?:攻擊|攻击)[^0-9]{0,8}(\d{3,5})/);
            if (atkMatch) out.stats["攻擊"] = atkMatch[1];

            const defMatch = cleanText.match(/(?:防禦|防御)[^0-9]{0,8}(\d{2,5})/);
            if (defMatch) out.stats["防禦"] = defMatch[1];

            const erMatch = cleanText.match(/(?:共鳴效率|共鸣效率|鳴效率|效率)[^0-9%]{0,8}(\d{2,3}(?:\.\d+)?%?)/);
            if (erMatch) out.stats["共鳴效率"] = erMatch[1].endsWith("%") ? erMatch[1] : `${erMatch[1]}%`;

            const cdMatch = cleanText.match(/(?:暴擊傷害|暴击伤害|暴傷|擊傷害)[^0-9%]{0,8}(\d{2,3}(?:\.\d+)?%?)/);
            if (cdMatch) out.stats["暴擊傷害"] = cdMatch[1].endsWith("%") ? cdMatch[1] : `${cdMatch[1]}%`;

            const crMatch = cleanText.match(/(?:暴擊率|暴擊|暴击)(?!.*傷)[^0-9%]{0,8}(\d{1,3}(?:\.\d+)?%?)/);
            if (crMatch) out.stats["暴擊"] = crMatch[1].endsWith("%") ? crMatch[1] : `${crMatch[1]}%`;

            if (Object.keys(out.stats).length < 4) {
                const statOrder = ["生命", "攻擊", "防禦", "共鳴效率", "暴擊", "暴擊傷害"];
                const statLines = lines.filter(l => !/L[vV]\d/.test(l) && /\d{2,}/.test(l));
                if (statLines.length >= 6) {
                    const lastSix = statLines.slice(-6);
                    lastSix.forEach((lineStr, idx) => {
                        const key = statOrder[idx];
                        if (!out.stats[key]) {
                            const m = lineStr.match(/(\d+(?:\.\d+)?%?)/g);
                            if (m) {
                                let v = m[m.length - 1];
                                if (idx >= 3 && !v.includes("%")) v += "%";
                                out.stats[key] = v;
                            }
                        }
                    });
                }
            }

            return out;
        }

        function parseEchoTextFromOCR(rawText) {
            const rawLines = rawText.split("\n").map(l => normalizeOcrLine(l)).filter(l => l.length > 0);
            const result = {
                name: "已辨識聲骸 +25",
                cost: 4,
                mainStat: "未偵測到主屬性",
                equippedChar: "",
                substats: []
            };

            const fullNoSpace = normalizeOcrLine(rawText);
            const fullUpper = fullNoSpace.toUpperCase();

            const eqMatch = fullNoSpace.match(/([\u4e00-\u9fa5]{1,5})(?:裝配中|裝備中|装配中|裝配)/);
            if (eqMatch && eqMatch[1]) {
                result.equippedChar = eqMatch[1].replace(/^[裝配中]+/, "");
            }

            if (/C[O0]ST\s*4/.test(fullUpper)) result.cost = 4;
            else if (/C[O0]ST\s*3/.test(fullUpper)) result.cost = 3;
            else if (/C[O0]ST\s*1/.test(fullUpper)) result.cost = 1;

            const elementMainRegex = /(導電|熱熔|冷凝|氣動|衍射|湮滅|治療).*?([0-9]+\.?[0-9]*)\s*%?/;

            const statMatchers = [
                { key: "Crit_Damage", regex: /(暴擊傷害|暴傷|擊傷害|暴擊傷|暴.*傷).*?([0-9]+\.?[0-9]*)/ },
                { key: "Crit_Rate", regex: /(暴擊率|暴擊|暴率)(?!.*傷).*?([0-9]+\.?[0-9]*)/ },
                { key: "ER", regex: /(共鳴效率|鳴效率|共鳴效|效率|鳴效).*?([0-9]+\.?[0-9]*)/ },
                { key: "Skill_Damage", regex: /(共鳴技能傷害|共鳴技能|技能傷害|技能).*?([0-9]+\.?[0-9]*)/ },
                { key: "Ult_Damage", regex: /(共鳴解放傷害|共鳴解放|解放傷害|解放).*?([0-9]+\.?[0-9]*)/ },
                { key: "Basic_Attack_Damage", regex: /(普攻傷害|普攻).*?([0-9]+\.?[0-9]*)/ },
                { key: "Heavy_Attack_Damage", regex: /(重擊傷害|重擊).*?([0-9]+\.?[0-9]*)/ },
                { key: "Attack", regex: /(攻擊力|攻擊|攻).*?([0-9]+\.?[0-9]*)/ },
                { key: "HP", regex: /(生命值|生命|生).*?([0-9]+\.?[0-9]*)/ },
                { key: "Defence", regex: /(防禦力|防禦|防).*?([0-9]+\.?[0-9]*)/ }
            ];

            let candidateStats = [];

            for (let i = 0; i < rawLines.length; i++) {
                const line = rawLines[i];
                if (/裝配中|裝備中|装配中/.test(line)) continue;

                if (i === 0) {
                    const zhMatch = line.match(/[\u4e00-\u9fa5]{2,8}/);
                    if (zhMatch && !/(加成|攻擊|生命|防禦|暴擊|效率|裝配)/.test(zhMatch[0])) {
                        result.name = `${zhMatch[0]} +25`;
                    }
                }

                const elemMatch = line.match(elementMainRegex);
                if (elemMatch && result.mainStat === "未偵測到主屬性") {
                    result.mainStat = `${elemMatch[1]}傷害加成 ${elemMatch[2]}%`;
                    if (parseFloat(elemMatch[2]) === 30) result.cost = 3;
                    continue;
                }

                for (let m of statMatchers) {
                    const match = line.match(m.regex);
                    if (match) {
                        const allNums = line.match(/[0-9]+\.?[0-9]*/g);
                        if (!allNums) continue;
                        const rawVal = parseFloat(allNums[allNums.length - 1]);
                        if (isNaN(rawVal) || rawVal <= 0 || rawVal === 25) continue;

                        const hasDotOrPct = line.includes("%") || allNums[allNums.length - 1].includes(".");
                        let finalKey = m.key;

                        if (m.key === "Attack") {
                            finalKey = (hasDotOrPct || rawVal < 25) ? "Attack" : "Attack_Flat";
                        } else if (m.key === "HP") {
                            finalKey = (hasDotOrPct || rawVal < 40) ? "HP" : "HP_Flat";
                        } else if (m.key === "Defence") {
                            finalKey = (hasDotOrPct || rawVal < 30) ? "Defence" : "Defence_Flat";
                        }

                        candidateStats.push({ key: finalKey, val: rawVal, hasPct: hasDotOrPct });
                        break;
                    }
                }
            }

            for (let idx = 0; idx < candidateStats.length; idx++) {
                const item = candidateStats[idx];
                const meta = SUBSTAT_DATA[item.key];
                if (!meta) continue;

                if ((item.key === "Attack_Flat" && item.val >= 80) || (item.key === "HP_Flat" && item.val >= 1000)) {
                    continue;
                }

                if (result.mainStat === "未偵測到主屬性" && item.val > meta.max) {
                    result.mainStat = `${meta.name} ${item.val}${meta.unit}`;
                    continue;
                }

                if (result.substats.length < 5 && item.val <= meta.max * 1.05) {
                    if (!result.substats.some(s => s.key === item.key)) {
                        result.substats.push({ key: item.key, val: item.val });
                    }
                }
            }

            return result;
        }

        function renderEvaluatedHUD(echo, latency) {
            const charName = roleSelectEl ? roleSelectEl.value : "通用角色";
            const charCfg = CHAR_PRESETS[charName] || Object.values(CHAR_PRESETS)[0] || { weights: DEFAULT_DPS_WEIGHTS };
            const weights = charCfg.weights || DEFAULT_DPS_WEIGHTS;

            echoNameEl.textContent = echo.name;
            const costPill = echoCostPillEl;
            costPill.textContent = `COST ${echo.cost}`;
            costPill.className = `cost-pill cost-${echo.cost}`;
            echoMainEl.innerHTML = `<span>主屬性: ${echo.mainStat}</span>`;

            let totalScore = 0.0;
            let totalRv = 0.0;
            let critCount = 0;

            const subsStack = subsStackEl;
            subsStack.innerHTML = "";

            for (let i = 0; i < 5; i++) {
                const sub = echo.substats[i];
                if (sub) {
                    const meta = SUBSTAT_DATA[sub.key] || { name: sub.key, max: 10.0, unit: "%" };
                    const rvRatio = Math.min(1.0, sub.val / meta.max);
                    const rvPct = rvRatio * 100.0;
                    totalRv += rvPct;

                    const w = weights[sub.key] || 0.0;
                    totalScore += rvRatio * w * 100.0;

                    if (sub.key === "Crit_Rate" || sub.key === "Crit_Damage") critCount++;

                    const row = document.createElement("div");
                    row.className = "sub-row";
                    row.style.animationDelay = `${i * 0.04}s`;
                    row.innerHTML = `
                        <span class="sub-name">✦ ${meta.name}</span>
                        <div>
                            <span class="sub-val">${sub.val}${meta.unit}</span>
                            <span class="sub-rv">RV ${rvPct.toFixed(0)}%</span>
                        </div>
                    `;
                    subsStack.appendChild(row);
                } else {
                    const row = document.createElement("div");
                    row.className = "sub-row";
                    row.style.opacity = "0.4";
                    row.style.animationDelay = `${i * 0.04}s`;
                    row.innerHTML = `<span class="sub-name">✦ 第 ${i + 1} 孔</span><span class="sub-val">未偵測</span>`;
                    subsStack.appendChild(row);
                }
            }

            const sortedW = Object.values(weights).sort((a, b) => b - a);
            let theoreticalMax = 0.0;
            for (let i = 0; i < 5; i++) theoreticalMax += (sortedW[i] || 0.0) * 100.0;
            if (theoreticalMax <= 0) theoreticalMax = 500.0;

            const percentage = Math.min(100.0, (totalScore / theoreticalMax) * 100.0);

            let tierName = "C";
            let badgeClass = "badge-c";
            let tierTitle = "♻ C 建議重調";
            if (percentage >= 85.0) { tierName = "SSS"; badgeClass = "badge-sss"; tierTitle = "👑 SSS 傳家寶"; }
            else if (percentage >= 75.0) { tierName = "S"; badgeClass = "badge-s"; tierTitle = "🌟 S 優秀畢業"; }
            else if (percentage >= 60.0) { tierName = "A"; badgeClass = "badge-a"; tierTitle = "✨ A 及格好用"; }
            else if (percentage >= 45.0) { tierName = "B"; badgeClass = "badge-b"; tierTitle = "📦 B 過渡良品"; }

            const badgeEl = gradeBadgeEl;
            badgeEl.className = `grade-badge ${badgeClass} pop-anim`;
            badgeEl.textContent = tierTitle;

            scoreMainEl.textContent = `${totalScore.toFixed(1)} / ${theoreticalMax.toFixed(1)} (${percentage.toFixed(1)}%)`;
            rvInfoEl.textContent = `總 RV: ${totalRv.toFixed(1)}% | 雙暴 ${critCount} 條`;

            const advBox = adviceBannerEl;
            advBox.className = "advice-banner";
            if (percentage >= 85.0) {
                advBox.textContent = `👑 【SSS 極品傳家寶】${charName.split("(")[0]} 完美適配！`;
            } else if (percentage >= 75.0) {
                advBox.textContent = `🌟 【S 優秀大畢業】核心詞條兼備，推薦鎖定裝配！`;
            } else if (percentage >= 60.0) {
                advBox.textContent = `✨ 【A 及格良品】過渡期可用胚子，可先裝配提升戰力。`;
            } else {
                advBox.className = "advice-banner advice-warn";
                advBox.textContent = `🛑 【建議重調】有效詞條偏低，建議作為升級素材。`;
            }

            addLog(`📸 [聲骸OCR] 主詞條: ${echo.mainStat} | 副詞條: ${echo.substats.length} 條 -> ${totalScore.toFixed(1)}分 (${tierName}) [${latency}ms]`, "log-success");
        }

        document.getElementById("btn-open-pip").addEventListener("click", async () => {
            if (pipWindowRef && !pipWindowRef.closed) {
                try { pipWindowRef.focus(); } catch (_) { }
                return;
            }

            if ('documentPictureInPicture' in window) {
                try {
                    const pipWindow = await window.documentPictureInPicture.requestWindow({
                        width: 395,
                        height: 560
                    });
                    pipWindowRef = pipWindow;

                    document.querySelectorAll('style, link[rel="stylesheet"]').forEach(style => {
                        pipWindow.document.head.appendChild(style.cloneNode(true));
                    });

                    pipWindow.document.body.appendChild(hudCardEl);
                    pipWindow.document.body.style.background = '#050811';
                    pipWindow.document.body.style.padding = '8px';
                    pipWindow.document.body.style.margin = '0';

                    addLog("📱 畫中畫獨立 HUD 已彈出！", "log-info");

                    pipWindow.addEventListener('pagehide', () => {
                        pipWindowRef = null;
                        if (hudCardEl && hudWrapperEl && !hudWrapperEl.contains(hudCardEl)) {
                            hudWrapperEl.appendChild(hudCardEl);
                        }
                        addLog("畫中畫視窗已還原至網頁。", "log-info");
                    }, { once: true });

                    return;
                } catch (e) {
                    pipWindowRef = null;
                    addLog(`⚠️ Document PiP 失敗，改用影片 PiP：${e.message}`, "log-warn");
                }
            }

            if (videoEl && videoEl.requestPictureInPicture) {
                try {
                    await videoEl.requestPictureInPicture();
                } catch (err) {
                    alert("畫中畫開啟失敗: " + err.message);
                }
            } else {
                alert("目前瀏覽器尚未支援畫中畫 API，建議使用最新版 Chrome 或 Edge！");
            }
        });

        roleSelectEl.addEventListener("change", () => {
            addLog(`手動切換目標角色為: 【${roleSelectEl.value}】`, "log-info");
            if (lastRecognizedEcho) {
                renderEvaluatedHUD(lastRecognizedEcho, 0);
            }
            if (g_hudCurrentMode === "panel") {
                refreshCharacterPanelDisplay();
            }
        });
    </script>
