<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>鳴潮聲骸直播串流與即時辨識 HUD · 官方網頁版 (GAMEZH)</title>
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
    <style>
        :root {
            --bg-base: #050811;
            --bg-surface: rgba(11, 18, 34, 0.92);
            --bg-card: rgba(18, 29, 54, 0.75);
            --border-subtle: rgba(56, 189, 248, 0.25);
            --border-glow: rgba(56, 189, 248, 0.6);
            --primary: #38bdf8;
            --primary-glow: rgba(56, 189, 248, 0.4);
            --accent-gold: #f59e0b;
            --accent-purple: #c084fc;
            --accent-green: #10b981;
            --accent-red: #ef4444;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --text-dim: #64748b;
            --font-mono: "Rajdhani", "SF Mono", Monaco, Consolas, monospace;
            --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif;
            --anim-speed: 0.28s;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: var(--font-sans);
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-base);
            background-image:
                radial-gradient(circle at 10% 20%, rgba(56, 189, 248, 0.08) 0%, transparent 45%),
                radial-gradient(circle at 90% 80%, rgba(192, 132, 252, 0.08) 0%, transparent 45%);
            color: var(--text-main);
            min-height: 100vh;
            padding: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .no-anim *,
        .no-anim *::before,
        .no-anim *::after {
            transition: none !important;
            animation: none !important;
        }

        @keyframes fadeSlideUp {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes popUpdate {
            0% {
                transform: scale(0.96);
            }
            50% {
                transform: scale(1.03);
            }
            100% {
                transform: scale(1);
            }
        }

        @keyframes roleSwitchGlow {
            0% {
                box-shadow: 0 0 0 rgba(56, 189, 248, 0);
                border-color: var(--primary);
            }
            50% {
                box-shadow: 0 0 18px rgba(56, 189, 248, 0.75);
                border-color: #fbbf24;
            }
            100% {
                box-shadow: 0 0 0 rgba(56, 189, 248, 0);
                border-color: rgba(255, 255, 255, 0.08);
            }
        }

        .broadcast-bar {
            width: 100%;
            max-width: 1200px;
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            padding: 10px 16px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
            backdrop-filter: blur(16px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
            transition: all var(--anim-speed) ease;
        }

        .broadcast-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .live-indicator {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 800;
            background: rgba(239, 68, 68, 0.15);
            color: var(--accent-red);
            border: 1px solid rgba(239, 68, 68, 0.4);
            letter-spacing: 0.5px;
            transition: all var(--anim-speed) ease;
        }

        .live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent-red);
        }

        .live-streaming .live-indicator {
            background: rgba(16, 185, 129, 0.15);
            color: var(--accent-green);
            border-color: rgba(16, 185, 129, 0.4);
        }

        .live-streaming .live-dot {
            background: var(--accent-green);
            box-shadow: 0 0 10px var(--accent-green);
            animation: pulse-live 1.2s infinite;
        }

        @keyframes pulse-live {
            0% {
                transform: scale(0.9);
                opacity: 0.7;
            }
            50% {
                transform: scale(1.2);
                opacity: 1;
            }
            100% {
                transform: scale(0.9);
                opacity: 0.7;
            }
        }

        .brand-title {
            font-size: 15px;
            font-weight: 800;
            color: #fff;
            letter-spacing: 0.5px;
        }

        .stream-controls {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
        }

        .interval-setting {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(0, 0, 0, 0.4);
            padding: 4px 10px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 700;
        }

        .interval-input {
            width: 55px;
            background: #070e1c;
            border: 1px solid var(--border-glow);
            color: var(--primary);
            font-family: var(--font-mono);
            font-size: 14px;
            font-weight: 800;
            padding: 3px 6px;
            border-radius: 4px;
            text-align: center;
            outline: none;
        }

        .btn {
            background: rgba(56, 189, 248, 0.15);
            color: var(--primary);
            border: 1px solid var(--primary);
            padding: 7px 14px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all var(--anim-speed) cubic-bezier(0.22, 1, 0.36, 1);
        }

        .btn:hover,
        .btn:active {
            background: var(--primary);
            color: #000;
            box-shadow: 0 0 14px var(--primary-glow);
            transform: translateY(-1px);
        }

        .btn-live-start {
            background: linear-gradient(135deg, #0284c7, #0ea5e9);
            color: #fff;
            border-color: rgba(255, 255, 255, 0.2);
            box-shadow: 0 4px 14px rgba(2, 132, 199, 0.4);
        }

        .btn-scan-loop {
            background: rgba(16, 185, 129, 0.2);
            color: var(--accent-green);
            border-color: var(--accent-green);
        }

        .btn-scan-loop.scanning {
            background: var(--accent-green);
            color: #000;
            box-shadow: 0 0 16px rgba(16, 185, 129, 0.6);
        }

        .btn-pip {
            background: rgba(192, 132, 252, 0.15);
            color: var(--accent-purple);
            border-color: var(--accent-purple);
        }

        .studio-grid {
            width: 100%;
            max-width: 1200px;
            display: grid;
            grid-template-columns: 1fr;
            gap: 14px;
        }

        @media (min-width: 900px) {
            .studio-grid {
                grid-template-columns: 1fr 395px;
            }
        }

        .monitor-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            backdrop-filter: blur(16px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
        }

        .monitor-screen {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #020409;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #stream-video {
            width: 100%;
            height: 100%;
            object-fit: fill;
            display: none;
        }

        .screen-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            color: var(--text-dim);
            text-align: center;
            padding: 20px;
        }

        .screen-placeholder-icon {
            font-size: 40px;
            opacity: 0.6;
            margin-bottom: 4px;
        }

        .scan-overlay-box {
            position: absolute;
            left: 70%;
            top: 11%;
            width: 28%;
            height: 46%;
            border: 2px dashed rgba(56, 189, 248, 0.85);
            border-radius: 6px;
            pointer-events: none;
            display: none;
            box-shadow: inset 0 0 15px rgba(56, 189, 248, 0.2);
            transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .scan-overlay-subbox {
            position: absolute;
            left: 77%;
            top: 84.5%;
            width: 14%;
            height: 5%;
            border: 1.5px dashed rgba(245, 158, 11, 0.85);
            border-radius: 4px;
            pointer-events: none;
            display: none;
            box-shadow: inset 0 0 10px rgba(245, 158, 11, 0.2);
            transition: all 0.35s ease;
        }

        .scan-overlay-label {
            position: absolute;
            top: -20px;
            left: 0;
            background: var(--primary);
            color: #000;
            font-size: 10px;
            font-weight: 800;
            padding: 1px 6px;
            border-radius: 3px;
            white-space: nowrap;
        }

        .scan-overlay-sublabel {
            position: absolute;
            top: -16px;
            left: 0;
            background: var(--accent-gold);
            color: #000;
            font-size: 9px;
            font-weight: 800;
            padding: 0 4px;
            border-radius: 3px;
            white-space: nowrap;
        }

        .laser-beam {
            position: absolute;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--primary), transparent);
            box-shadow: 0 0 8px var(--primary);
            display: none;
            animation: laser-sweep 1.2s infinite ease-in-out;
        }

        @keyframes laser-sweep {
            0% {
                top: 0%;
                opacity: 0.2;
            }
            50% {
                opacity: 1;
            }
            100% {
                top: 100%;
                opacity: 0.2;
            }
        }

        .monitor-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
            font-size: 11px;
            color: var(--text-dim);
            font-family: var(--font-mono);
            padding: 2px 4px;
        }

        .meta-stat {
            color: var(--primary);
            font-weight: 800;
        }

        .bottom-console-grid {
            display: grid;
            grid-template-columns: 1fr 180px;
            gap: 10px;
        }

        .terminal-box {
            background: #02050e;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            padding: 10px;
            height: 150px;
            overflow-y: auto;
            font-family: var(--font-mono);
            font-size: 11px;
            line-height: 1.5;
            color: #94a3b8;
        }

        .preview-box {
            background: #02050e;
            border: 1px solid rgba(56, 189, 248, 0.3);
            border-radius: 8px;
            height: 150px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        .preview-box span {
            position: absolute;
            top: 4px;
            left: 6px;
            font-size: 9px;
            font-weight: 800;
            color: #000;
            background: var(--primary);
            padding: 1px 4px;
            border-radius: 3px;
            z-index: 2;
        }

        #crop-canvas {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .log-entry {
            margin-bottom: 2px;
            animation: fadeSlideUp 0.2s ease;
        }

        .log-time {
            color: var(--text-dim);
        }

        .log-success {
            color: #34d399;
        }

        .log-warn {
            color: #fbbf24;
        }

        .log-info {
            color: #38bdf8;
        }

        .hud-wrapper {
            width: 100%;
        }

        .hud-card {
            position: relative;
            overflow: hidden;
            background: var(--bg-surface);
            border: 1px solid var(--border-glow);
            border-radius: 12px;
            padding: 14px;
            backdrop-filter: blur(16px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
            transition: all var(--anim-speed) cubic-bezier(0.22, 1, 0.36, 1);
            z-index: 1;
        }

        .hud-custom-bg {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            opacity: 0;
            pointer-events: none;
            z-index: -2;
            transition: opacity var(--anim-speed) ease;
        }

        .hud-custom-dim {
            position: absolute;
            inset: 0;
            background: rgba(5, 8, 17, 0.65);
            pointer-events: none;
            z-index: -1;
            transition: background var(--anim-speed) ease;
        }

        .hud-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 8px;
            margin-bottom: 10px;
        }

        .role-picker {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(0, 0, 0, 0.45);
            padding: 6px 10px;
            border-radius: 8px;
            margin-bottom: 10px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all var(--anim-speed) ease;
        }

        .role-picker.role-switched {
            animation: roleSwitchGlow 0.9s ease;
        }

        .auto-role-label {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 11px;
            font-weight: 800;
            color: var(--accent-green);
            cursor: pointer;
            user-select: none;
            padding: 2px 6px;
            border-radius: 5px;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.35);
            white-space: nowrap;
            transition: all var(--anim-speed) ease;
        }

        .auto-role-label:hover {
            background: rgba(16, 185, 129, 0.22);
        }

        .auto-role-label input[type="checkbox"] {
            accent-color: var(--accent-green);
            width: 13px;
            height: 13px;
            cursor: pointer;
        }

        .role-picker select {
            background: rgba(11, 20, 38, 0.9);
            color: #fff;
            border: 1px solid var(--border-glow);
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 800;
            outline: none;
            flex: 1;
            min-width: 0;
            transition: all var(--anim-speed) ease;
        }

        .echo-info-card {
            background: rgba(15, 23, 42, 0.82);
            border-left: 4px solid var(--primary);
            border-radius: 8px;
            padding: 8px 10px;
            margin-bottom: 10px;
            transition: all var(--anim-speed) ease;
        }

        .echo-top-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 4px;
            gap: 6px;
        }

        .echo-name {
            font-size: 14px;
            font-weight: 800;
            color: #fff;
        }

        .equipped-tag {
            font-size: 10px;
            font-weight: 800;
            color: #fbbf24;
            background: rgba(245, 158, 11, 0.16);
            border: 1px solid rgba(245, 158, 11, 0.45);
            padding: 1px 6px;
            border-radius: 4px;
            margin-left: auto;
        }

        .cost-pill {
            font-size: 10px;
            font-weight: 900;
            padding: 1px 6px;
            border-radius: 4px;
            background: rgba(56, 189, 248, 0.2);
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .cost-4 {
            color: #f59e0b;
            border-color: #f59e0b;
            background: rgba(245, 158, 11, 0.15);
        }

        .cost-3 {
            color: #c084fc;
            border-color: #c084fc;
            background: rgba(192, 132, 252, 0.15);
        }

        .cost-1 {
            color: #38bdf8;
            border-color: #38bdf8;
            background: rgba(56, 189, 248, 0.15);
        }

        .echo-main-stat {
            font-size: 12px;
            color: var(--accent-purple);
            font-weight: 700;
            display: flex;
            justify-content: space-between;
        }

        .grade-dash {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0, 0, 0, 0.48);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            padding: 8px 10px;
            margin-bottom: 10px;
            transition: all var(--anim-speed) ease;
        }

        .grade-badge {
            font-size: 13px;
            font-weight: 900;
            padding: 4px 10px;
            border-radius: 6px;
            letter-spacing: 0.5px;
            transition: all var(--anim-speed) ease;
        }

        .badge-sss {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #000;
            box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
        }

        .badge-s {
            background: linear-gradient(135deg, #a855f7, #c084fc);
            color: #fff;
            box-shadow: 0 0 12px rgba(192, 132, 252, 0.5);
        }

        .badge-a {
            background: linear-gradient(135deg, #0284c7, #38bdf8);
            color: #fff;
        }

        .badge-b {
            background: linear-gradient(135deg, #059669, #10b981);
            color: #fff;
        }

        .badge-c {
            background: #475569;
            color: #cbd5e1;
        }

        .score-info {
            text-align: right;
        }

        .score-main {
            font-size: 15px;
            font-weight: 900;
            color: #fbbf24;
            font-family: var(--font-mono);
        }

        .score-sub {
            font-size: 10px;
            color: var(--text-dim);
        }

        .advice-banner {
            background: rgba(16, 185, 129, 0.14);
            border: 1px solid rgba(16, 185, 129, 0.4);
            border-radius: 8px;
            padding: 8px 10px;
            font-size: 11px;
            font-weight: 700;
            color: #34d399;
            line-height: 1.45;
            margin-bottom: 10px;
            transition: all var(--anim-speed) ease;
        }

        .advice-warn {
            background: rgba(239, 68, 68, 0.14);
            border-color: rgba(239, 68, 68, 0.5);
            color: #f87171;
        }

        .subs-stack {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin-bottom: 4px;
        }

        .sub-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(15, 23, 42, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.06);
            padding: 5px 8px;
            border-radius: 6px;
            font-size: 11px;
            animation: fadeSlideUp var(--anim-speed) ease both;
            transition: transform 0.2s ease, background 0.2s ease;
        }

        .sub-row:hover {
            background: rgba(56, 189, 248, 0.12);
            transform: translateX(2px);
        }

        .sub-name {
            color: #cbd5e1;
            font-weight: 600;
        }

        .sub-val {
            color: var(--primary);
            font-weight: 800;
            font-family: var(--font-mono);
            font-size: 12px;
        }

        .sub-rv {
            font-size: 9px;
            padding: 1px 4px;
            border-radius: 3px;
            background: rgba(0, 0, 0, 0.5);
            color: var(--text-dim);
            font-weight: 700;
            margin-left: 4px;
        }

        #full-canvas,
        #header-canvas {
            display: none;
        }

        .ms-app-banner {
            width: 100%;
            max-width: 1200px;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.92));
            border: 1px solid rgba(56, 189, 248, 0.35);
            border-radius: 12px;
            padding: 10px 18px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
        }

        .ms-brand-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .ms-brand-title {
            font-size: 13px;
            font-weight: 800;
            color: #38bdf8;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .ms-brand-sub {
            font-size: 11px;
            color: #94a3b8;
            margin-top: 2px;
        }

        .btn-ms-download {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: linear-gradient(135deg, #0284c7, #0369a1);
            color: #ffffff;
            text-decoration: none;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 800;
            border: 1px solid rgba(56, 189, 248, 0.5);
            transition: all 0.2s ease;
        }

        .btn-ms-download:hover {
            background: linear-gradient(135deg, #38bdf8, #0284c7);
            box-shadow: 0 0 14px rgba(56, 189, 248, 0.5);
            transform: translateY(-1px);
        }

        .hud-top-actions {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .hud-btn-action {
            background: rgba(56, 189, 248, 0.15);
            border: 1px solid rgba(56, 189, 248, 0.45);
            color: #38bdf8;
            padding: 3px 8px;
            border-radius: 5px;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
            transition: all var(--anim-speed) ease;
        }

        .hud-btn-action:hover {
            background: rgba(56, 189, 248, 0.35);
            color: #ffffff;
            border-color: #38bdf8;
        }

        .hud-btn-rescan {
            background: rgba(16, 185, 129, 0.18);
            border-color: rgba(16, 185, 129, 0.45);
            color: #34d399;
        }

        .hud-btn-rescan:hover {
            background: rgba(16, 185, 129, 0.38);
            border-color: #10b981;
            color: #ffffff;
        }

        .hud-mode-bar {
            display: flex;
            gap: 4px;
            margin-bottom: 8px;
            background: rgba(0, 0, 0, 0.38);
            padding: 3px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

